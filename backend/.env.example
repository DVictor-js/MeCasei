APP_ENV=development
PORT=8000
# Python no host usa 5433. O Compose ajusta a conexão para postgres:5432.
# Usuário/senha abaixo são placeholders públicos de desenvolvimento, não segredos reais.
DATABASE_URL=postgresql+psycopg://mecasei:change-me@127.0.0.1:5433/mecasei
POSTGRES_USER=mecasei
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mecasei
# Propositalmente inválido: gere sua chave e não versione o .env real.
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:8081
